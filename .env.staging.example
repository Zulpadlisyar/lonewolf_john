# ==============================================================================
# LONEWOLF SPORTSWEAR - 100% FREE STAGING ENVIRONMENT CONFIGURATION
# ==============================================================================
# Target URL: https://lonewolf-staging.vercel.app (or custom staging subdomain)
# All services below are 100% FREE tier with ZERO charges.
# ==============================================================================

# 1. RUNTIME & ISOLATION
NODE_ENV=production
APP_ENV=staging
NEXT_PUBLIC_APP_URL="https://lonewolf-staging.vercel.app"
NEXT_PUBLIC_API_URL="https://lonewolf-staging.vercel.app/api"

# 2. STAGING ACCESS RESTRICTION (HTTP Basic Auth - Built into Middleware)
# Protects the staging app from public search engines and unauthorized visitors for FREE
STAGING_AUTH_USER="YOUR_STAGING_USER"
STAGING_AUTH_PASS="YOUR_STRONG_STAGING_PASSWORD"

# 3. DATABASE (Neon Serverless PostgreSQL - 100% Free Tier)
# Region: Singapore (ap-southeast-1) | 0.5 GB storage | Daily snapshot backups
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-staging-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-staging-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 4. AUTHENTICATION (Random 32-char string)
NEXTAUTH_SECRET="staging-only-random-secret-key-32chars-min"
NEXTAUTH_URL="https://lonewolf-staging.vercel.app"
COOKIE_DOMAIN=""

# 5. PAYMENT GATEWAY (Midtrans Sandbox Simulator - 100% Free)
PAYMENT_MODE=sandbox
MIDTRANS_SERVER_KEY="SB-Mid-server-YOUR-SANDBOX-SERVER-KEY"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR-SANDBOX-CLIENT-KEY"
MIDTRANS_IS_PRODUCTION=false

# 6. SHIPPING (Biteship Sandbox / Built-in Mock Couriers - 100% Free)
SHIPPING_MODE=sandbox
BITESHIP_API_KEY="biteship_test.YOUR-SANDBOX-KEY"
ORIGIN_POSTAL_CODE="12190"

# 7. EMAIL SINK (Mailtrap.io Free Tier - 100% Free Sandbox Inbox)
EMAIL_PROVIDER=mailtrap
MAIL_FROM="LoneWolf Staging <staging@lonewolf-test.id>"
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="YOUR_MAILTRAP_USERNAME"
SMTP_PASSWORD="YOUR_MAILTRAP_PASSWORD"

# 8. OBJECT STORAGE (Cloudflare R2 Free Tier - 10 GB Free, $0 Egress)
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
STORAGE_BUCKET_NAME="lonewolf-media-staging"
STORAGE_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
STORAGE_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
NEXT_PUBLIC_STORAGE_PUBLIC_URL="https://media-staging.lonewolfapparel.com"

# 9. OBSERVABILITY (Sentry Free Developer Tier)
NEXT_PUBLIC_SENTRY_DSN=""
LOG_LEVEL=info
MAINTENANCE_MODE=false
CHECKOUT_DISABLED=false

