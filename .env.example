# ==============================================================================
# LONEWOLF SPORTSWEAR COMMERCE PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# IMPORTANT SECURITY RULES:
# 1. DO NOT PUT REAL SECRETS IN THIS FILE OR IN GIT.
# 2. Copy this file to .env.local for local development.
# 3. For Staging and Production, configure variables via hosting platform secret manager.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & HOSTING ENVIRONMENT
# ------------------------------------------------------------------------------
# Choices: development | staging | production | test
NODE_ENV=development
APP_ENV=development

# Base URLs
# Local: http://localhost:3000
# Staging: https://staging.lonewolfapparel.com
# Production: https://lonewolfapparel.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Staging and Production MUST use strictly isolated database instances.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lonewolf_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lonewolf_dev?schema=public"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
# Strong 32+ character random secret (openssl rand -base64 32)
NEXTAUTH_SECRET="your-32-char-random-secret-here-for-local-development"
NEXTAUTH_URL=http://localhost:3000

# Cookie domain setting (leave empty for localhost)
# Staging: staging.lonewolfapparel.com
# Production: .lonewolfapparel.com
COOKIE_DOMAIN=""

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Midtrans Sandbox / Live)
# ------------------------------------------------------------------------------
# Mode: sandbox | production
PAYMENT_MODE=sandbox
MIDTRANS_SERVER_KEY="SB-Mid-server-your-sandbox-server-key"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-your-sandbox-client-key"
MIDTRANS_IS_PRODUCTION=false

# ------------------------------------------------------------------------------
# 5. SHIPPING & LOGISTICS (Biteship API / RajaOngkir)
# ------------------------------------------------------------------------------
# Mode: sandbox | live | manual_fallback
SHIPPING_MODE=sandbox
BITESHIP_API_KEY="biteship_test.your-sandbox-api-key"
ORIGIN_POSTAL_CODE="12190"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Staging: Use Mailtrap / Inbucket
# Production: Resend.com / SendGrid with verified DNS
EMAIL_PROVIDER=mailtrap
MAIL_FROM="LoneWolf Sportswear <no-reply@lonewolfapparel.com>"

# Mailtrap / SMTP Test Configuration (Local & Staging)
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your-mailtrap-username"
SMTP_PASSWORD="your-mailtrap-password"

# Resend API Key (Production only)
RESEND_API_KEY="re_your_resend_api_key"

# ------------------------------------------------------------------------------
# 7. OBJECT STORAGE (Media & Product Assets - S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
STORAGE_BUCKET_NAME="lonewolf-media-dev"
STORAGE_ACCESS_KEY_ID="your-r2-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-r2-secret-access-key"
NEXT_PUBLIC_STORAGE_PUBLIC_URL="https://media-dev.lonewolfapparel.com"

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & MONITORING
# ------------------------------------------------------------------------------
# Sentry DSN (Separate project/environment per Staging and Production)
NEXT_PUBLIC_SENTRY_DSN=""
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 9. EMERGENCY & FEATURE CONTROLS
# ------------------------------------------------------------------------------
# Maintenance mode toggle: true | false
MAINTENANCE_MODE=false
CHECKOUT_DISABLED=false

